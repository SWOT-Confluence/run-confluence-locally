Useful commands (run from anywhere; use sbatch for anything heavier than a single reach):

```bash
PY={{ py }}
# Where is reach X in every module: index, class, output file, log file
$PY -m confluence.monitor locate {{ run_dir }} <reach_id>
# Current status of a live run (also in monitor/status.txt)
$PY -m confluence.monitor status {{ run_dir }}
# Re-audit (add --baseline <other run dir> to compare; --full to open every file)
sbatch --wrap "$PY -m confluence.monitor audit {{ run_dir }}" --mem 8G --time 1:00:00 --account {{ ctx.hpc.account }}
# Rerun one reach (index i) of a per-reach module; n = length of its index file
sbatch --export=OFFSET=<i>,INDEX_RANGE=1,MAX_LIMIT=<n> --array=0 {{ run_dir }}/sh_scripts/<module>.sh
# Live jobs of this run / cancel the whole run
squeue -u $USER -o "%i %j %T %R" | grep _{{ run_name }}_cfl
{{ repo_root }}/kill_jobs.sh -n {{ run_name }}
```
